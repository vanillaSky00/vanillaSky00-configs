      "element.active": "#292929",
      "element.selected": "#292929",
      "ghost_element.background": "#000000",
      "ghost_element.hover": "#222222",
      "ghost_element.active": "#292929",
      "ghost_element.selected": "#292929",
      "editor.background": "#000000",
      "editor.foreground": "#f0f6fcff",
      "editor.gutter.background": "#000000",
